    "claims": [
      {
        "id": "CLM-610d29713d42d156660b2c43",
        "parent_claim_id": null,
        "agent_run_id": "RUN-bb658cafc35be42f3b1360d5",
        "agent_role": "Classicist",
        "claim_type": "DIRECT_TEXT",
        "assertion_text": "大青龙汤中麻黄用量为六两，是麻黄汤中麻黄三两用量的两倍。",
        "rationale_summary": "证据直接列出了两方的组成和剂量：麻黄汤麻黄三两，大青龙汤麻黄六两。",
        "status": "ACTIVE",
        "audit_status": "SUPPORTED",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68b-e487-7b47-84fb-8ab9c5b045f1",
            "revision_no": 1
          },
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      },
      {
        "id": "CLM-88b3f8831dd9d443bbcf7258",
        "parent_claim_id": null,
        "agent_run_id": "RUN-bb658cafc35be42f3b1360d5",
        "agent_role": "Classicist",
        "claim_type": "TEXTUAL_RELATION",
        "assertion_text": "大青龙汤主治证候为外感风寒、内有郁热，其表寒更重，且兼见烦躁；而麻黄汤主治为单纯的外感风寒表实证，无里热烦躁。",
        "rationale_summary": "证据对比了两方的主治：麻黄汤主治外感风寒表实证，症状为恶寒发热、无汗而喘；大青龙汤主治外感风寒、内有郁热证，症状为恶寒发热、无汗而烦躁。",
        "status": "ACTIVE",
        "audit_status": "SUPPORTED",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68b-e487-7b47-84fb-8ab9c5b045f1",
            "revision_no": 1
          },
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      },
      {
        "id": "CLM-aca7e928c1b8332e010821ea",
        "parent_claim_id": null,
        "agent_run_id": "RUN-bb658cafc35be42f3b1360d5",
        "agent_role": "Classicist",
        "claim_type": "TEXTUAL_RELATION",
        "assertion_text": "大青龙汤倍用麻黄，是为了增强发汗解表之力以应对更重的表寒闭郁；同时配伍石膏清里热，麻黄与石膏相伍，使麻黄辛温发表而无助热之弊。",
        "rationale_summary": "证据指出大青龙汤证属风寒重证，兼内有郁热，故倍用麻黄以确保发汗之力；并说明麻黄得石膏，辛温发表而无助热之弊。",
        "status": "ACTIVE",
        "audit_status": "SUPPORTED",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      },
      {
        "id": "CLM-3b62815e1355605eb1c02107",
        "parent_claim_id": null,
        "agent_run_id": "RUN-a7791d24c411f2dfd26f9a8e",
        "agent_role": "Theorist",
        "claim_type": "TEXTUAL_RELATION",
        "assertion_text": "麻黄汤与大青龙汤的组成、剂量和主治证候存在明确差异。麻黄汤由麻黄三两、桂枝二两、杏仁七十个、甘草一两组成，主治外感风寒表实证，症见恶寒发热、无汗而喘。大青龙汤由麻黄六两、桂枝二两、甘草二两、杏仁四十粒、石膏如鸡子大、生姜三两、大枣十二枚组成，主治外感风寒、内有郁热证，症见恶寒发热、无汗而烦躁。",
        "rationale_summary": "证据中分别列出了两方的完整组成、原方剂量及主治证候，通过对比可得出上述差异。",
        "status": "ACTIVE",
        "audit_status": "PENDING_SEMANTIC",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68b-e487-7b47-84fb-8ab9c5b045f1",
            "revision_no": 1
          },
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      },
      {
        "id": "CLM-d5c69642f5b3c02c2ba2b8ef",
        "parent_claim_id": null,
        "agent_run_id": "RUN-a7791d24c411f2dfd26f9a8e",
        "agent_role": "Theorist",
        "claim_type": "TEXTUAL_RELATION",
        "assertion_text": "大青龙汤主治证候的核心病机是风寒束表较重，且阳气内郁化热，导致“烦躁”；而麻黄汤主治证候的核心病机是单纯的风寒束表、肺气失宣，以“无汗而喘”为特征，无里热表现。",
        "rationale_summary": "证据指出麻黄汤证为“风寒束表，肺气失宣”，大青龙汤证为“风寒束表，表气闭郁较重，致使阳气内郁而化热”，并强调“烦躁”是鉴别要点。",
        "status": "ACTIVE",
        "audit_status": "PENDING",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68b-e487-7b47-84fb-8ab9c5b045f1",
            "revision_no": 1
          },
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      },
      {
        "id": "CLM-2876893c68b248c2e9004641",
        "parent_claim_id": null,
        "agent_run_id": "RUN-a7791d24c411f2dfd26f9a8e",
        "agent_role": "Theorist",
        "claim_type": "THEORETICAL_INFERENCE",
        "assertion_text": "（推论）大青龙汤中麻黄用量倍于麻黄汤，可能基于两个相互关联的原因：一是为了应对更重的表寒闭郁，需要更强的发汗力度以开泄腠理；二是配伍大寒的石膏清里热，石膏的寒凉性质可能对麻黄的辛温发散之力有一定制约，故需增加麻黄用量以确保其发汗解表的功效不被削弱，从而达到表里双解的目的。",
        "rationale_summary": "证据表明大青龙汤证属“风寒重证”，且方解指出其麻黄量为“麻黄汤之倍”以增强发汗散寒之力；同时指出麻黄与石膏配伍可相互制约（麻黄得石膏无助热之弊，石膏得麻黄无凉遏之虞）。由此推论，增加麻黄用量既针对病机，也考虑了与石膏的配伍关系。",
        "status": "ACTIVE",
        "audit_status": "PENDING",
        "evidence": [
          {
            "evidence_id": "EV-01a0f68d-647a-78cf-8b60-1d51bd1adb64",
            "revision_no": 1
          }
        ]
      }
